PORT=5000
MONGODB_URI=mongodb://localhost:27017/velt
JWT_SECRET=
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Real payment and game-provider credentials must be supplied only after contracting.
# No provider is enabled by default.

# Wallet migration: set the legacy wallet's actual currency before running migration.
LEGACY_BALANCE_CURRENCY=
# Display/read currency for ledger-backed wallet queries.
LEDGER_DEFAULT_CURRENCY=
# Enable only after wallet migration and opening-balance reconciliation are signed off.
WALLET_LEDGER_READS_ENABLED=false
# Payment webhook routing is provider-specific at /api/payments/webhooks/:provider.
PAYMENT_WEBHOOK_SECRET=
PAYMENT_RETURN_URL=https://your-verified-domain.example/payment/return

# Flutterwave v3 Standard checkout (use test keys until account, product and jurisdiction are approved)
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET_HASH=

# Paystack (use sk_test_* only for sandbox validation)
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Default provider for deposit intents; may be flutterwave or paystack.
PAYMENT_PROVIDER_ID=flutterwave

# Required trusted geolocation and operator policy configuration; real-money fails closed without these.
TRUSTED_GEOLOCATION_URL=
TRUSTED_GEOLOCATION_TOKEN=
VELT_OPERATOR_ENTITY=

# Sumsub sandbox first; obtain separate production credentials and review-level configuration
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_KYC_LEVEL=
